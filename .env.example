# Chatterbox Flash TTS server — environment options (template).
#
# Copy to `.env` (project defaults) or `.env.local` (per-machine overrides):
#   cp .env.example .env
#
# Precedence, highest first:
#   1. the real process environment (os.environ)
#   2. .env.local
#   3. .env
# A value set in the real environment always wins; the files only fill in
# what the environment does not set. All values below are the built-in
# defaults — uncomment/edit any you want to change.

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Worker pool ----------------------------------------------------------
# Maximum number of concurrently loaded model workers.
MAX_WORKERS=1
# Minimum loaded workers retained (baseline warmed at startup and the reap floor).
MIN_SPARE_WORKERS=1
# Idle TTL (seconds) before excess workers above MIN_SPARE_WORKERS are unloaded.
KEEP_ALIVE_TTL_SECONDS=300

# --- Model ----------------------------------------------------------------
# Hugging Face checkpoint to load.
MODEL_REPO=ResembleAI/chatterbox-flash
# Compute device: cuda | cpu | mps.
DEVICE=cuda
# Inference backend: auto | flashinfer | torch | mlx.
BACKEND=auto
# Numeric dtype: bfloat16 | float16 | float32.
DTYPE=bfloat16
# Decoder block size (drf_block_size).
BLOCK_SIZE=16

# --- Uploads & storage ----------------------------------------------------
# Max reference-audio upload size in bytes (default 25 MiB).
MAX_UPLOAD_BYTES=26214400
# Directory where generated WAV files are stored (kept indefinitely).
OUTPUT_DIR=output
